{
  "name": "bernabeu-3d-experience",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node tools/build_standalone.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import ./tests/register.mjs --test tests/*.test.js",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:build && npm run check:companion",
    "typecheck": "tsc -p tsconfig.json",
    "verify:build": "node tools/verify-build.mjs",
    "package:release": "node tools/package-release.mjs",
    "check:companion": "node tools/check-companion.mjs"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "three": "0.187.0",
    "vite": "8.3.6"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
